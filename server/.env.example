# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
APP_TZ=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://emp:emp@localhost:5432/emp
# Used only by `npm test` (it is dropped and recreated on every run)
TEST_DATABASE_URL=postgres://emp:emp@localhost:5432/emp_test

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# The single admin, created programmatically on first start / by `npm run create-admin`
ADMIN_EMAIL=admin@emp.edu
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Portal Administrator

# Redis: caching + background job queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Cache TTLs in seconds
CACHE_TTL_EXAMS=120
CACHE_TTL_SLOTS=30
CACHE_TTL_RUBRICS=600

# Email (MailHog from docker-compose catches everything at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EMP Portal <no-reply@emp.edu>"

# Optional Google Chat space webhook used for reminders when a student has none of their own
GCHAT_WEBHOOK_URL=

# Scheduled jobs (cron syntax, evaluated in APP_TZ)
REMINDER_CRON=0 8 * * *
REMINDER_DAYS_AHEAD=1
MONTHLY_REPORT_CRON=0 9 1 * *

# Where CSV exports and monthly report copies are written
EXPORT_DIR=./storage/exports

# Allow examiners to evaluate before the slot start time (handy for demos)
ALLOW_EARLY_EVALUATION=false

# VIVA DEMO ONLY: true switches booking to the naive, race-prone version (see services/naiveBooking.js)
NAIVE_BOOKING_DEMO=false
